# Copy to .env (which is gitignored) and fill in. Start services with: docker compose up -d
# Generate each secret with: openssl rand -hex 32  (placeholders are refused)
MONGODB_URI=mongodb://localhost:27017/bulk-applier
# Signs session cookies. At least 32 random characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=

# Public address of the app, used in link previews, robots.txt and the sitemap.
SITE_URL=http://localhost:3000

# Shown on /privacy and /terms as the address for privacy and legal questions.
# Required before going live.
CONTACT_EMAIL=

# Encrypts users' app passwords (users send applications from their own
# mailbox). Use a long random string; changing it disconnects every mailbox.
MAILBOX_SECRET=

# The app's own address, used only for verification codes.
FROM=noreply@bulk-applier.local

# Local mail catcher (Mailpit): while set, ALL mail (codes and applications)
# goes here instead of out, and users don't need to connect their email.
# Read it at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025

# In production: remove SMTP_HOST/SMTP_PORT, set FROM to a Gmail address and
# GMAIL_PASS to its app password (for verification codes).
# GMAIL_PASS=

# Database browser (mongo-express) at http://localhost:8081
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=
